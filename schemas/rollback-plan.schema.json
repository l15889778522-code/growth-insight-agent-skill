{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "route_revision", "rollback_revision", "review_stage_id", "review_artifact_sha256", "target_stage_id", "target_artifact_revision", "target_artifact_sha256", "required_fixes", "created_at"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "run_id": {"type": "string", "minLength": 3},
    "route_revision": {"type": "integer", "minimum": 1},
    "rollback_revision": {"type": "integer", "minimum": 1},
    "review_stage_id": {"type": "string", "minLength": 1},
    "review_artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "target_stage_id": {"type": "string", "minLength": 1},
    "target_artifact_revision": {"type": "integer", "minimum": 1},
    "target_artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "required_fixes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
