{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.multi-agent-data-analysis/schemas/route-plan.schema.json",
  "title": "Analysis Route Plan",
  "$defs": {
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_name", "input_type", "artifact_id", "path", "sha256", "source"],
      "properties": {
        "input_name": {"type": "string", "minLength": 1},
        "input_type": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "parallelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_agents", "merge_required"],
      "properties": {
        "enabled": {"type": "boolean"},
        "max_agents": {"type": "integer", "minimum": 1, "maximum": 2},
        "merge_required": {"type": "boolean"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_id", "route_revision", "task_type", "stages", "required_inputs", "provided_inputs", "missing_inputs", "fallback_route", "user_adjustments", "reused_approved_artifacts", "created_at"],
  "properties": {
    "schema_version": {"enum": ["1.1", "1.2"]},
    "route_id": {"type": "string", "minLength": 3},
    "route_revision": {"type": "integer", "minimum": 1},
    "task_type": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "role", "sequence", "depends_on", "required_inputs", "expected_outputs", "status"],
        "properties": {
          "stage_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "role": {"enum": ["growth-business", "growth-metrics", "growth-sql", "growth-insight", "growth-visualization", "growth-review", "growth-report"]},
          "sequence": {"type": "integer", "minimum": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "required_inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "expected_outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "status": {"enum": ["pending", "skipped", "approved", "stale"]},
          "parallel": {"$ref": "#/$defs/parallelPolicy"}
        }
      }
    },
    "required_inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provided_inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "input_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/inputBinding"}
    },
    "missing_inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fallback_route": {"type": ["object", "null"]},
    "user_adjustments": {"type": "array", "items": {"type": "string"}},
    "reused_approved_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "artifact_sha256", "input_hashes"],
        "properties": {
          "stage_id": {"type": "string"},
          "artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}},
      "then": {"required": ["input_bindings"]}
    }
  ]
}
