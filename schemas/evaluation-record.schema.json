{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "mode", "completed", "roles_run", "rule_checks", "quality_scores", "hallucination_count", "privilege_violation_count", "gate_bypass_count", "human_revisions", "elapsed_ms", "token_usage", "notes"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "case_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["single-codex", "v1.0", "v1.1"]},
    "completed": {"type": "boolean"},
    "roles_run": {"type": "array", "items": {"type": "string"}},
    "rule_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sql_safe", "schema_valid", "evidence_resolvable", "no_gate_bypass", "recovery_success"],
      "properties": {
        "sql_safe": {"type": "boolean"},
        "schema_valid": {"type": "boolean"},
        "evidence_resolvable": {"type": "boolean"},
        "no_gate_bypass": {"type": "boolean"},
        "recovery_success": {"type": "boolean"}
      }
    },
    "quality_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_coverage", "metric_consistency", "route_quality", "sql_executability", "evidence_traceability"],
      "properties": {
        "business_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "metric_consistency": {"type": "number", "minimum": 0, "maximum": 1},
        "route_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "sql_executability": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_traceability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "hallucination_count": {"type": "integer", "minimum": 0},
    "privilege_violation_count": {"type": "integer", "minimum": 0},
    "gate_bypass_count": {"type": "integer", "minimum": 0},
    "human_revisions": {"type": "integer", "minimum": 0},
    "elapsed_ms": {"type": ["integer", "null"], "minimum": 0},
    "token_usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
