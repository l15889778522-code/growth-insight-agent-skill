{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.multi-agent-data-analysis/schemas/run-state.schema.json",
  "title": "Multi-Agent Data Analysis Run State",
  "$defs": {
    "pendingApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_type", "subject_id", "subject_revision", "subject_sha256"],
      "properties": {
        "approval_type": {"enum": ["route", "stage", "rollback"]},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_revision": {"type": "integer", "minimum": 1},
        "subject_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "pendingQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_type", "subject_id", "subject_revision", "subject_sha256", "query_sha256", "data_source_id", "data_source_fingerprint", "dialect", "timeout_seconds", "max_rows", "max_result_bytes", "approved", "approval_id"],
      "properties": {
        "approval_type": {"const": "query"},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_revision": {"type": "integer", "minimum": 1},
        "subject_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "query_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "data_source_id": {"type": "string", "minLength": 1},
        "data_source_fingerprint": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "dialect": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_rows": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_result_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
        "approved": {"type": "boolean"},
        "approval_id": {"type": ["string", "null"]}
        ,"request_path": {"type": "string", "minLength": 1}
        ,"request_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        ,"sql_path": {"type": "string", "minLength": 1}
      }
    },
    "pendingMetricEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edit_id", "stage_id", "operation", "metric_id", "base_artifact_sha256", "edit_path", "edit_sha256"],
      "properties": {
        "edit_id": {"type": "string", "minLength": 3},
        "stage_id": {"type": "string", "minLength": 1},
        "operation": {"enum": ["add", "modify", "delete", "batch"]},
        "metric_id": {"type": "string", "minLength": 1},
        "base_artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "edit_path": {"type": "string", "minLength": 1},
        "edit_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "stageArtifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "revision", "json_path", "markdown_path", "markdown_sha256", "validation_path", "validation_sha256", "sha256", "stage_status"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "stage_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "json_path": {"type": "string", "minLength": 1},
        "markdown_path": {"type": "string", "minLength": 1},
        "markdown_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "validation_path": {"type": "string", "minLength": 1},
        "validation_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "stage_status": {"enum": ["PASS", "PASS_WITH_RISKS", "BLOCKED", "FAIL"]},
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "raw_response_path": {"type": "string", "minLength": 1},
        "raw_response_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "fileArtifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "metadata": {"type": "object"},
        "superseded_by": {"type": "string", "minLength": 1}
      }
    },
    "attemptRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "started_at", "completed_at", "elapsed_ms", "thread_id", "model", "model_reasoning_effort", "token_usage", "failure_class"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "elapsed_ms": {"type": ["integer", "null"], "minimum": 0},
        "thread_id": {"type": ["string", "null"]},
        "agent_id": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "model_reasoning_effort": {"type": ["string", "null"]},
        "token_usage": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "total_tokens"],
          "properties": {
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "total_tokens": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "failure_class": {"type": ["string", "null"]},
        "receipt_path": {"type": ["string", "null"]},
        "receipt_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "raw_response_path": {"type": ["string", "null"]},
        "raw_response_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "provenance_trust_level": {"type": ["string", "null"], "enum": [null, "self_asserted", "host_observed", "host_signed"]},
        "capture_method": {"type": ["string", "null"], "enum": [null, "root_cli", "codex_tool_result", "migration"]},
        "missing_metadata": {"type": "array", "items": {"enum": ["agent_id", "model", "token_usage"]}, "uniqueItems": true}
      }
    },
    "executionLease": {
      "$ref": "execution-lease.schema.json"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "status",
    "runtime",
    "route_id",
    "route_revision",
    "route_sha256",
    "current_stage",
    "pending_stage",
    "stages",
    "approved_artifacts",
    "pending_approval",
    "pending_query",
    "pending_metric_edit",
    "artifacts",
    "data_source",
    "last_event_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"enum": ["1.1", "1.2"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "revision": {"type": "integer", "minimum": 0},
    "status": {
      "enum": [
        "initialized",
        "awaiting_route_confirmation",
        "running",
        "validating",
        "finalizing",
        "awaiting_user_confirmation",
        "awaiting_query_confirmation",
        "revising",
        "blocked",
        "failed",
        "stopped",
        "completed"
      ]
    },
    "completion_kind": {"type": ["string", "null"], "enum": ["review_terminal", "report", null]},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model_policy", "agent_config_hashes", "resolved_models", "agent_settings"],
      "properties": {
        "kind": {"const": "codex_native"},
        "model_policy": {"enum": ["native-portable", "native-explicit"]},
        "agent_config_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}},
        "resolved_models": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
        "agent_settings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "model_reasoning_effort", "sandbox_mode"],
            "properties": {
              "model": {"type": ["string", "null"]},
              "model_reasoning_effort": {"type": ["string", "null"]},
              "sandbox_mode": {"type": ["string", "null"]}
            }
          }
        },
        "surface": {"type": ["string", "null"]},
        "contract_version": {"enum": ["1.1", "1.2"]}
      }
    },
    "route_id": {"type": ["string", "null"]},
    "route_revision": {"type": "integer", "minimum": 0},
    "route_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "current_stage": {"type": ["string", "null"]},
    "pending_stage": {"type": ["string", "null"]},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "role", "status", "attempt", "depends_on", "input_hashes", "artifact", "runtime", "attempt_history"],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["growth-business", "growth-metrics", "growth-sql", "growth-insight", "growth-visualization", "growth-review", "growth-report"]},
          "status": {"enum": ["pending", "running", "validating", "awaiting_user_confirmation", "approved", "revising", "blocked", "failed", "stale", "skipped", "completed"]},
          "attempt": {"type": "integer", "minimum": 0},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}},
          "artifact": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["revision", "json_path", "markdown_path", "markdown_sha256", "validation_path", "validation_sha256", "sha256", "stage_status"],
            "properties": {
              "artifact_id": {"type": "string", "minLength": 1},
              "revision": {"type": "integer", "minimum": 1},
              "json_path": {"type": "string", "minLength": 1},
              "markdown_path": {"type": "string", "minLength": 1},
              "markdown_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
              "validation_path": {"type": "string", "minLength": 1},
              "validation_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
              "stage_status": {"enum": ["PASS", "PASS_WITH_RISKS", "BLOCKED", "FAIL"]},
              "receipt_path": {"type": "string", "minLength": 1},
              "receipt_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
              "raw_response_path": {"type": "string", "minLength": 1},
              "raw_response_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
            }
          },
          "runtime": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/attemptRuntime"}]},
          "attempt_history": {
            "type": "array",
            "items": {"$ref": "#/$defs/attemptRuntime"}
          }
        }
      }
    },
    "approved_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_id", "artifact_revision", "artifact_sha256", "approval_id"],
        "properties": {
          "stage_id": {"type": "string"},
          "artifact_revision": {"type": "integer", "minimum": 1},
          "artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "approval_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "pending_approval": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/pendingApproval"}]},
    "pending_query": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/pendingQuery"}]},
    "pending_metric_edit": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/pendingMetricEdit"}]},
    "execution_leases": {"type": "array", "items": {"$ref": "#/$defs/executionLease"}},
    "artifacts": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/stageArtifactRecord"}, {"$ref": "#/$defs/fileArtifactRecord"}]}},
    "data_source": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["data_source_id", "data_source_fingerprint", "dialect"],
          "properties": {
            "data_source_id": {"type": "string", "minLength": 1},
            "data_source_fingerprint": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
            "dialect": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "last_event_id": {"type": "integer", "minimum": 0},
    "resume_status": {"type": ["string", "null"], "enum": [null, "initialized", "awaiting_route_confirmation", "running", "validating", "finalizing", "awaiting_user_confirmation", "awaiting_query_confirmation", "revising", "blocked", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}},
      "then": {"required": ["execution_leases", "completion_kind"]}
    }
  ]
}
