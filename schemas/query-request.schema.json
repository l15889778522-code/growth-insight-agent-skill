{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_id", "revision", "sql_path", "sql_sha256", "subject_sha256", "data_source_id", "data_source_fingerprint", "dialect", "timeout_seconds", "max_rows", "max_result_bytes", "created_at"],
  "properties": {
    "schema_version": {"enum": ["1.1", "1.2"]},
    "query_id": {"type": "string", "minLength": 3},
    "revision": {"type": "integer", "minimum": 1},
    "sql_path": {"type": "string", "minLength": 1},
    "sql_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "subject_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "data_source_id": {"type": "string", "minLength": 1},
    "data_source_fingerprint": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "dialect": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_rows": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "max_result_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
