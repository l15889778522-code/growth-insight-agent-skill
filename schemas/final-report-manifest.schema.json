{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.multi-agent-data-analysis/schemas/final-report-manifest.schema.json",
  "title": "Final Report Publication Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "lease_id",
    "report_stage_id",
    "report_artifact_id",
    "report_stage_sha256",
    "review_artifact_id",
    "review_decision",
    "lineage_artifact_id",
    "chart_manifest_artifact_id",
    "final_report_path",
    "final_report_sha256",
    "final_report_bytes",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "run_id": {"type": "string", "minLength": 3},
    "lease_id": {"type": "string", "minLength": 3},
    "report_stage_id": {"type": "string", "minLength": 1},
    "report_artifact_id": {"type": "string", "minLength": 1},
    "report_stage_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "review_artifact_id": {"type": ["string", "null"]},
    "review_decision": {"enum": ["PASS", "PASS_WITH_RISKS"]},
    "lineage_artifact_id": {"type": ["string", "null"]},
    "chart_manifest_artifact_id": {"type": ["string", "null"]},
    "final_report_path": {"type": "string", "minLength": 1},
    "final_report_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "final_report_bytes": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
