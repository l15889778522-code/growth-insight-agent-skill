{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.multi-agent-data-analysis/schemas/review-input-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "route_revision", "review_stage_id", "inputs", "approved_decisions", "created_at"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "run_id": {"type": "string", "minLength": 3},
    "route_revision": {"type": "integer", "minimum": 1},
    "review_stage_id": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "role", "artifact_id", "artifact_revision", "artifact_sha256", "json_path"],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_revision": {"type": "integer", "minimum": 1},
          "artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "json_path": {"type": "string", "minLength": 1}
        }
      }
    },
    "approved_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "artifact_sha256", "decision"],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "decision": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "object"}]}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
