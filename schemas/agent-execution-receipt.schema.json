{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.multi-agent-data-analysis/schemas/agent-execution-receipt.schema.json",
  "title": "Native Agent Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "stage_id",
    "role",
    "attempt",
    "agent_config_sha256",
    "agent_id",
    "raw_response_path",
    "raw_response_sha256",
    "stage_json_path",
    "stage_json_sha256",
    "stage_semantic_sha256",
    "started_at",
    "completed_at",
    "model",
    "model_reasoning_effort",
    "token_usage",
    "missing_metadata",
    "capture_method",
    "trust_level",
    "host_receipt",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "receipt_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "stage_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["growth-business", "growth-metrics", "growth-sql", "growth-insight", "growth-visualization", "growth-review", "growth-report"]},
    "attempt": {"type": "integer", "minimum": 1},
    "agent_config_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "agent_id": {"type": ["string", "null"], "minLength": 1},
    "raw_response_path": {"type": "string", "minLength": 1},
    "raw_response_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "stage_json_path": {"type": "string", "minLength": 1},
    "stage_json_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "stage_semantic_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "model": {"type": ["string", "null"]},
    "model_reasoning_effort": {"type": ["string", "null"]},
    "token_usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "missing_metadata": {
      "type": "array",
      "items": {"enum": ["agent_id", "model", "token_usage"]},
      "uniqueItems": true
    },
    "capture_method": {"enum": ["root_cli", "codex_tool_result", "migration"]},
    "trust_level": {"enum": ["self_asserted", "host_observed", "host_signed"]},
    "host_receipt": {"type": ["object", "null"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"trust_level": {"const": "host_observed"}}},
      "then": {"properties": {"agent_id": {"type": "string", "minLength": 1}, "capture_method": {"const": "codex_tool_result"}}}
    },
    {
      "if": {"properties": {"trust_level": {"const": "host_signed"}}},
      "then": {"properties": {"host_receipt": {"type": "object"}}}
    }
  ]
}
