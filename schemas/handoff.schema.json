{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.multi-agent-data-analysis/schemas/handoff.schema.json",
  "$defs": {
    "textOrObject": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "kind"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "kind": {"type": "string", "minLength": 1}
      }
    }
  },
  "title": "Common Agent Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_contract_version",
    "run_id",
    "stage_id",
    "role",
    "attempt",
    "stage_status",
    "summary",
    "confirmed_decisions",
    "conflicts",
    "facts",
    "calculations",
    "assumptions",
    "hypotheses",
    "evidence",
    "metrics",
    "data_artifacts",
    "risks",
    "open_questions",
    "required_next_inputs",
    "recommended_next_stage",
    "lineage",
    "role_payload"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "agent_contract_version": {"const": "1.1"},
    "run_id": {"type": "string", "minLength": 3},
    "stage_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["growth-business", "growth-metrics", "growth-sql", "growth-insight", "growth-visualization", "growth-review", "growth-report"]},
    "attempt": {"type": "integer", "minimum": 1},
    "stage_status": {"enum": ["PASS", "PASS_WITH_RISKS", "BLOCKED", "FAIL"]},
    "summary": {"type": "string", "minLength": 1},
    "confirmed_decisions": {"type": "array", "items": {"$ref": "#/$defs/textOrObject"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/textOrObject"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/textOrObject"}},
    "calculations": {"type": "array", "items": {"$ref": "#/$defs/textOrObject"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/textOrObject"}},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/textOrObject"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/textOrObject"}},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id", "name", "version"],
        "properties": {
          "metric_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 1}
        }
      }
    },
    "data_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/textOrObject"}},
    "open_questions": {"type": "array", "items": {"$ref": "#/$defs/textOrObject"}},
    "required_next_inputs": {"type": "array", "items": {"type": "string"}},
    "recommended_next_stage": {"type": ["string", "null"]},
    "lineage": {"type": "array", "items": {"type": "object"}},
    "role_payload": {"type": "object"}
  }
}
