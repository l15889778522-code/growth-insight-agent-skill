{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.multi-agent-data-analysis/schemas/metric-lineage-v1.2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metrics"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "metric_version",
          "definition_artifact",
          "sql_expressions",
          "query_ids",
          "result_artifacts",
          "result_columns",
          "insight_evidence",
          "chart_ids",
          "recommendation_refs",
          "breaks"
        ],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "metric_version": {"type": "integer", "minimum": 1},
          "definition_artifact": {"type": ["string", "null"]},
          "sql_expressions": {"type": "array", "items": {"type": "string"}},
          "query_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "result_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_id", "path", "sha256", "query_id", "query_revision"],
              "properties": {
                "artifact_id": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
                "query_id": {"type": "string", "minLength": 1},
                "query_revision": {"type": "integer", "minimum": 1}
              }
            }
          },
          "result_columns": {"type": "array", "items": {"type": "string"}},
          "insight_evidence": {"type": "array", "items": {"$ref": "evidence-ref.schema.json"}},
          "chart_ids": {"type": "array", "items": {"type": "string"}},
          "recommendation_refs": {"type": "array", "items": {"$ref": "evidence-ref.schema.json"}},
          "breaks": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
