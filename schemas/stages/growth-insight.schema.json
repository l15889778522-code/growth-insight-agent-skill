{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {"$ref": "../handoff.schema.json"},
    {
      "type": "object",
      "properties": {
        "role": {"const": "growth-insight"},
        "role_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observations", "attribution_hypotheses", "counter_evidence", "validation_steps", "recommendations", "confidence_notes"],
          "properties": {
            "observations": {"type": "array", "items": {"$ref": "#/$defs/evidenceStatement"}},
            "attribution_hypotheses": {"type": "array", "items": {"type": "object"}},
            "counter_evidence": {"type": "array", "items": {"type": "string"}},
            "validation_steps": {"type": "array", "items": {"type": "string"}},
            "recommendations": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
            "confidence_notes": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "statement", "metric_ids", "evidence_refs", "confidence"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "metric_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_id", "text", "metric_ids", "evidence_refs"],
      "properties": {
        "recommendation_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "metric_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
