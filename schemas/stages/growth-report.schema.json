{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {"$ref": "../handoff.schema.json"},
    {
      "type": "object",
      "properties": {
        "role": {"const": "growth-report"},
        "role_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executive_summary", "evidence_summary", "recommendations", "caveats", "next_steps"],
          "properties": {
            "executive_summary": {"type": "string", "minLength": 1},
            "evidence_summary": {"type": "array", "items": {"type": "string"}},
            "recommendations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["recommendation_id", "text", "metric_ids", "evidence_refs"],
                "properties": {
                  "recommendation_id": {"type": "string", "minLength": 1},
                  "text": {"type": "string", "minLength": 1},
                  "metric_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                  "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
                }
              }
            },
            "caveats": {"type": "array", "items": {"type": "string"}},
            "next_steps": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  ]
}
