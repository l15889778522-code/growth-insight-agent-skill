{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {"$ref": "../handoff.schema.json"},
    {
      "type": "object",
      "properties": {
        "role": {"const": "growth-metrics"},
        "role_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metrics", "dependency_gaps", "conflict_checks"],
          "properties": {
            "metrics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["metric_id", "name", "type", "business_definition", "formula", "grain", "dimensions", "time_window", "field_dependencies", "status", "source", "owner", "data_risks", "version"],
                "properties": {
                  "metric_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$"},
                  "name": {"type": "string", "minLength": 1},
                  "type": {"enum": ["north-star", "core", "process", "guardrail", "diagnostic"]},
                  "business_definition": {"type": "string", "minLength": 1},
                  "formula": {"type": "string", "minLength": 1},
                  "grain": {"type": "string", "minLength": 1},
                  "dimensions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                  "time_window": {"type": "string", "minLength": 1},
                  "field_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
                  "status": {"enum": ["exploratory", "candidate", "official"]},
                  "source": {"type": "string", "minLength": 1},
                  "owner": {"type": "string", "minLength": 1},
                  "data_risks": {"type": "array", "items": {"type": "string"}},
                  "version": {"type": "integer", "minimum": 1}
                }
              }
            },
            "dependency_gaps": {"type": "array", "items": {"type": "string"}},
            "conflict_checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
          }
        }
      }
    }
  ]
}
